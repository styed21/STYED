{
  "name": "styed-official",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .cache/ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check:output": "node scripts/check-output.mjs",
    "generate:map": "node scripts/generate-map.mjs",
    "format": "prettier --write src components scripts *.html *.json *.ts README.md docs/map-integration.md",
    "format:check": "prettier --check src components scripts *.html *.json *.ts README.md docs/map-integration.md"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "clsx": "2.1.1",
    "dotted-map": "3.1.0",
    "framer-motion": "13.2.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "shadcn": "^4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
